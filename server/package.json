{
  "name": "fig-server",
  "version": "1.0.0",
  "private": true,
  "description": "API e database di FIG: sincronizzazione per utente, autenticazione Keycloak, SQLite",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include .env src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/api.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
