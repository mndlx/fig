# ——— Configurazione del server FIG ———
# Copia questo file in server/.env (sviluppo) o /opt/fig/.env (produzione) e compila i valori.
# Il file .env non va mai nel repository: contiene il client secret.

# Indirizzo da cui si apre l'app. Il login torna su PUBLIC_URL/auth/callback,
# che deve essere tra i "Valid redirect URIs" del client su Keycloak.
#   sviluppo:   http://localhost:5174
#   produzione: https://fig.vlabstudio.net
PUBLIC_URL=http://localhost:5174

# Keycloak: realm e client confidenziale
OIDC_ISSUER=https://identity.vlabstudio.net/realms/virtual-systems
OIDC_CLIENT_ID=fig
# Keycloak → realm virtual-systems → Clients → fig → tab "Credentials" → Client secret
OIDC_CLIENT_SECRET=

# Durata della sessione dell'app in giorni (si rinnova a ogni utilizzo)
SESSION_DAYS=30

# Porta del server e file del database SQLite
PORT=8787
DB_PATH=data/fig.db

# Solo sviluppo locale: 1 salta il login e usa un utente fisso
AUTH_DISABLED=0

# Cartella del frontend compilato (npm run build nella cartella principale)
STATIC_DIR=../dist
