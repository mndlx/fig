# Porta del server (API + frontend compilato)
PORT=8787

# File del database SQLite
DB_PATH=data/fig.db

# Realm Keycloak che contiene il client "fig"
OIDC_ISSUER=https://identity.vlabstudio.net/realms/REALM
OIDC_CLIENT_ID=fig

# Solo sviluppo locale: 1 salta il login e usa un utente fisso
AUTH_DISABLED=0

# Cartella del frontend compilato (npm run build nella cartella principale)
STATIC_DIR=../dist
